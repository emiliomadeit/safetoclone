// Tells Cloudflare how to run the site. The pages are plain files; worker.js handles /api/*, /mcp and the Instagram robot.
{
  "name": "safetoclone",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // These addresses go through worker.js first: the home page (so shared links /?repo=owner/name get a matching
    // link preview) and the pages built for Google in seo.js (/repo/owner/name, /repos, /sitemap.xml).
    "run_worker_first": ["/", "/repo/*", "/repos", "/repos/", "/about", "/sitemap.xml", "/__sandbox", "/__sandbox/*", "/robots.txt"]
  },
  // Checks every 30 minutes for an Instagram post whose time (Ottawa) has come, and posts it.
  "triggers": { "crons": ["*/30 * * * *"] },
  // Storage where instagram.js keeps the renewed Instagram token (KV namespace "safetoclone-instagram").
  "kv_namespaces": [{ "binding": "INSTAGRAM", "id": "c6dcee47a48741efbf4530730b19f4ed" }],
  // Limits per connection (Cloudflare counts them per location, and only roughly). Used by agent.js (allowed) and worker.js.
  // Where a binding is missing (tests, pull request previews), nothing is limited. Needs Wrangler 4.36 or newer.
  "ratelimits": [
    { "name": "CHECK_LIMIT", "namespace_id": "50101", "simple": { "limit": 15, "period": 60 } },  // new checks: each costs GitHub lookups
    { "name": "SIGNUP_LIMIT", "namespace_id": "50102", "simple": { "limit": 5, "period": 60 } },   // /api/subscribe
    { "name": "API_LIMIT", "namespace_id": "50103", "simple": { "limit": 60, "period": 60 } }     // /api/osv and /api/hit
  ],
  // Lets Cloudflare build a test copy of the site for every pull request.
  // Native Worker Previews do not inherit production bindings or secrets.
  // Never add the production KV namespace, HQ token, Resend or Instagram secrets here.
  "previews": {
    "vars": { "SAFETOCLONE_ENV": "sandbox" },
    "version_metadata": { "binding": "SANDBOX_VERSION" }
  }
}
