// Tells Cloudflare how to run the site. The pages are plain files; worker.js handles /api/*, /mcp and the daily Instagram post.
{
  "name": "safetoclone",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // The home page goes through worker.js first, so shared links (/?repo=owner/name) get a matching link preview.
    "run_worker_first": ["/"]
  },
  // Posts today's Instagram post every day at 14:00 UTC (10am Ottawa in summer, 9am in winter).
  "triggers": { "crons": ["0 14 * * *"] },
  // Storage where instagram.js keeps the renewed Instagram token (KV namespace "safetoclone-instagram").
  "kv_namespaces": [{ "binding": "INSTAGRAM", "id": "c6dcee47a48741efbf4530730b19f4ed" }],
  // Lets Cloudflare build a test copy of the site for every pull request.
  "previews": {}
}
