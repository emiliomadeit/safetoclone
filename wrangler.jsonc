// Tells Cloudflare how to run the site. The pages are plain files; worker.js only handles /api/subscribe.
{
  "name": "safetoclone",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  // Lets Cloudflare build a test copy of the site for every pull request.
  "previews": {}
}
